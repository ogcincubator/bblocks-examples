{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Example of a simple GeoJSON Feature specialisation",
  "$defs": {
    "MyFeature": {
      "allOf": [
        {
          "$ref": "https://ogcincubator.github.io/bblocks-examples/build/annotated/bbr/examples/feature/externalSchema/schema.json"
        },
        {
          "properties": {
            "properties": {
              "properties": {
                "Name": {
                  "x-jsonld-id": "rdfs:label"
                }
              }
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/MyFeature"
    }
  ],
  "x-bblocks-metadata": {
    "itemIdentifier": "ogc.bbr.examples.feature.overrideContext",
    "register": "https://ogcincubator.github.io/bblocks-examples/build/register.json",
    "version": "1.0",
    "dateOfLastChange": "2026-11-04"
  }
}