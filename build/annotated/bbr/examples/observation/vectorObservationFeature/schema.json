{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Example SOSA Observation Specialisation - a vector bearing and distance",
  "$defs": {
    "VectorObservation": {
      "allOf": [
        {
          "$ref": "https://opengeospatial.github.io/ogcapi-sosa/build/annotated/sosa/features/observation/schema.json"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "$ref": "https://ogcincubator.github.io/bblocks-examples/build/annotated/bbr/examples/observation/vectorObservation/schema.json"
            }
          }
        }
      ]
    },
    "VectorObservationMember": {
      "allOf": [
        {
          "$ref": "https://opengeospatial.github.io/ogcapi-sosa/build/annotated/sosa/features/observation/schema.json#/$defs/member"
        },
        {
          "type": "object",
          "properties": {
            "properties": {
              "$ref": "https://ogcincubator.github.io/bblocks-examples/build/annotated/bbr/examples/observation/vectorObservation/schema.json#/$defs/member"
            }
          }
        }
      ]
    },
    "VectorObservationCollection": {
      "allOf": [
        {
          "$ref": "https://opengeospatial.github.io/ogcapi-sosa/build/annotated/sosa/features/observationCollection/schema.json"
        },
        {
          "type": "object",
          "properties": {
            "features": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/VectorObservationMember"
              }
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/VectorObservation"
    },
    {
      "$ref": "#/$defs/VectorObservationCollection"
    }
  ],
  "x-bblocks-metadata": {
    "itemIdentifier": "ogc.bbr.examples.observation.vectorObservationFeature",
    "register": "https://ogcincubator.github.io/bblocks-examples/build/register.json",
    "version": "1.0",
    "dateOfLastChange": "2026-11-09"
  }
}