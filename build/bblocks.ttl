            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://rob-metalinkage.github.io/bblocks-examples/build/register.json> ] ;
    foaf:homepage <https://rob-metalinkage.github.io/bblocks-examples/> ;
