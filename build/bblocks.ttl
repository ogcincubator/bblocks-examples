    rdfs:label "Marine Protections Ontology" ;
    dct:abstract "Example ontology for the regulation of marine managed areas, minting only the terms that have no exact equivalent in the ontologies of the OGC Cross Domain Model. Definitions are taken from the ProtectedSeas Navigator data dictionary."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-11-03T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://rob-metalinkage.github.io/bblocks-examples/build/generateddocs/json-full/bbr/examples/linkeddata/marine-protection-ontology/index.json> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://rob-metalinkage.github.io/bblocks-examples/build/generateddocs/markdown/bbr/examples/linkeddata/marine-protection-ontology/index.md> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://rob-metalinkage.github.io/bblocks-examples/bblock/ogc.bbr.examples.linkeddata.marine-protection-ontology> ] ;
